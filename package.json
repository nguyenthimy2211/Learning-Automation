{
  "name": "learning-automation",
  "version": "1.0.0",
  "description": "This project is my first automation demo, created to practice and improve my automation skills through hands-on exercises.\r It helps me practice every day, reinforce what I've learned, and review my knowledge through practical examples.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --project=chromium",
    "test:smoke": "npx playwright test --project=chromium --grep @smoke",
    "test:regression": "npx playwright test --project=chromium --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "linter": "eslint --ext .ts tests pages locators utilities data --fix",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "prepare": "husky",
    "check:all": "npm run linter && npm run typecheck",
    "allure-generate": "allure generate allure-results",
    "allure-serve": "allure serve allure-results",
    "show-report": "npx playwright show-report",
    "codegen": "cross-env ENV=qa npx playwright codegen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenthimy2211/Learning-Automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nguyenthimy2211/Learning-Automation/issues"
  },
  "homepage": "https://github.com/nguyenthimy2211/Learning-Automation#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.8",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "uuidv7": "^1.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "xlsx": "^0.18.5",
    "csv-parse": "^7.0.3",
    "lint-staged": "^17.6.0"
  },
   "lint-staged": {
    "*.{js,ts}": [
      "eslint --ext .ts tests pages locators utilities data --fix"
    ]
  }
}
