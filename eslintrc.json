{
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "env": {
        "es2021": true,
        "node": true,
        "browser": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/eslint-recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "rules": {
        "@typescript-eslint/object-curly-spacing": [
            "error",
            "always"
        ],
        "no-trailing-spaces": [
            "error",
            {
                "skipBlankLines": false
            }
        ],
        "no-multiple-empty-lines": [
            "error",
            {
                "max": 2,
                "maxEOF": 0
            }
        ],
        "quotes": [
            "error",
            "single",
            {
                "avoidEscape": true
            }
        ],
        "no-console": 2,
        "no-empty-pattern": "warn",
        "@typescript-eslint/no-explicit-any": [
            "off"
        ],
        "semi": [
            2,
            "always"
        ]
    },
    "overrides": [
        {
            "files": ["pages/**/*.ts"],
            "rules": {
                "no-restricted-syntax": [
                    "error",
                    {
                        "selector": "CallExpression[callee.property.name='catch'] > ArrowFunctionExpression > Literal[value=false]",
                        "message": "Do not silence errors with .catch(() => false) in page objects. Handle errors explicitly or let them propagate."
                    }
                ]
            }
        }
    ]
}
